{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@marvinho/ui": ["../../packages/ui/src"],
      "@marvinho/ui/*": ["../../packages/ui/src/*"],
      "@marvinho/config": ["../../packages/config/src"],
      "@marvinho/hooks": ["../../packages/hooks/src"],
      "@marvinho/types": ["../../packages/types/src"],
      "@marvinho/utils": ["../../packages/utils/src"],
      "@marvinho/branding": ["../../packages/branding/src"],
      "@marvinho/forms": ["../../packages/forms/src"],
      "@marvinho/shared": ["../../packages/shared/src"],
      "@marvinho/icons": ["../../packages/icons/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
